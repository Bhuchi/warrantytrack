# Copy to backend/.env and fill in. Never commit backend/.env
#
# You do NOT need this file to run `docker compose up` — Compose supplies
# working defaults. It's only needed to run the API directly on your machine,
# or once we have real AWS credentials.

ENVIRONMENT=development
SECRET_KEY=change-me-in-dev

# Running the API directly on your machine (uvicorn):
DATABASE_URL=postgresql://warranty:warranty@localhost:5432/warrantytrack
#
# NOTE: inside Docker Compose the database host is `db`, not `localhost`.
# Compose sets DATABASE_URL itself and deliberately overrides this value,
# so you don't need to change it when switching between the two.

# Origins allowed to call the API, as a JSON array.
CORS_ORIGINS=["http://localhost:3000"]

# Where this API is reachable. Only used to build the dev upload URL below.
API_BASE_URL=http://localhost:8000

# AWS — leave blank until the account exists. See infra/README.md.
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
SES_SENDER_EMAIL=

# Which implementation each outside service uses.
#
# The defaults below need no AWS account and cost nothing, so the receipt
# upload -> OCR -> confirm flow and the expiry scan all work on
# `docker compose up`:
#
#   local    uploads are kept on the API container's disk, and the browser PUTs
#            to /documents/{id}/dev-upload instead of to S3
#   fake     OCR returns canned fields instead of calling Textract
#   log      email is written to the application log instead of sent
#   dev      auth skips Cognito; every request is the seeded dev user
#            (create it with `python -m scripts.seed_dev`)
#
# Flip all four once the AWS account exists. None of them is allowed when
# ENVIRONMENT=production — the app refuses to start, because an email that is
# silently not sent is worse than one that fails loudly.
STORAGE_BACKEND=local
OCR_BACKEND=fake
EMAIL_BACKEND=log
AUTH_BACKEND=dev

# How long a presigned S3 URL stays valid. Short: the bucket is private and a
# leaked URL is a leaked object until it expires.
PRESIGNED_URL_TTL_SECONDS=900

# Where STORAGE_BACKEND=local writes. Inside the container, so scratch uploads
# disappear with it.
LOCAL_UPLOAD_DIR=/tmp/warrantytrack-uploads

# Bedrock OCR (OCR_BACKEND=bedrock). Copy the model ID from the Bedrock console
# and make sure the model is enabled for your account. Needs AWS credentials.
BEDROCK_MODEL_ID=
BEDROCK_REGION=
