  "cards": [
    {
      "dot": "cyan",
      "title": "Three decisions",
      "items": [
        "One workspaces table: a personal account is a workspace with one member",
        "Cognito authenticates, the memberships table authorizes, strangers get 404",
        "OCR runs outside the request: presign, direct PUT, then poll the document"
      ]
    },
    {
      "dot": "emerald",
      "title": "Local and AWS are the same shape",
      "items": [
        "STORAGE, OCR and EMAIL backends switch between s3/textract/ses and local/fake/log",
        "Startup refuses to run in production on any development backend",
        "docker compose runs db, backend and frontend with no AWS account"
      ]
    },
    {
      "dot": "amber",
      "title": "Where dev still differs from the plan",
      "items": [
        "Identity is a stub in app/api/deps.py, while the role lookup is already real",
        "Extraction is synchronous, so a crash can strand a document in processing",
        "EventBridge for the scan and S3-to-Lambda OCR are documented next steps"
      ]
    }
  ]
