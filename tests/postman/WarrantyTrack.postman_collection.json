    {
      "name": "4. Bulk import",
      "description": "",
      "item": [
        {
          "name": "Dry run a CSV with one bad row",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/csv"
              }
            ],
            "url": "{{baseUrl}}/assets/import?mode=validate",
            "body": {
              "mode": "raw",
              "raw": "name,serial_number,purchase_date,price,invoice_number,vendor,category,warranty_provider,warranty_start_date,warranty_duration_months\nImport Monitor,IMP-{{serial}},2026-10-01,5990,INV-IMP-1,JIB,Monitor,Dell,2026-10-01,12\nBroken Row,,not-a-date,5990,INV-IMP-2,JIB,Monitor,Dell,2026-10-01,12\n"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('reads both rows', () => pm.expect(body.total_rows).to.eql(2));",
                  "pm.test('one row is valid', () => pm.expect(body.valid).to.eql(1));",
                  "pm.test('the bad row is reported as row 3', () => pm.expect(body.errors.map((e) => e.row)).to.include(3));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Receipts and OCR",
      "description": "",
      "item": [
        {
          "name": "Get an upload URL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/documents/presign",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filename\": \"sample-receipt.png\",\n  \"content_type\": \"image/png\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('documentId', body.document_id);",
                  "pm.collectionVariables.set('uploadUrl', body.upload_url);"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload the receipt file",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "image/png"
              },
              {
                "key": "X-Skip-Auth",
                "value": "1"
              }
            ],
            "url": "{{uploadUrl}}",
            "body": {
              "mode": "file",
              "file": {
                "src": "../robot/files/sample-receipt.png"
              }
            },
            "description": "Goes to S3 on AWS (no token: the URL is already signed) or to the dev-upload route locally."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('upload accepted (200 from S3, 204 locally)', () => pm.expect(pm.response.code).to.be.oneOf([200, 204]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Start reading the receipt",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/documents/{{documentId}}/submit"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Read the extracted details",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/documents/{{documentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const doc = pm.response.json();",
                  "pm.test('extraction finished', () => pm.expect(doc.status).to.eql('extracted'));",
                  "pm.test('found at least one line item', () => pm.expect(doc.extracted.line_items.length).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm the receipt into an asset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/documents/{{documentId}}/confirm",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assets\": [\n    {\n      \"name\": \"Postman OCR Laptop\",\n      \"serial_number\": \"OCR-{{serial}}\",\n      \"condition\": \"new\",\n      \"purchase_date\": \"2026-11-01\",\n      \"price\": \"32900.00\",\n      \"currency\": \"THB\",\n      \"invoice_number\": \"PM-INV-001\",\n      \"vendor_name\": \"Power Buy\",\n      \"category_name\": \"Laptop\",\n      \"storage_note\": \"Box on the top shelf\",\n      \"warranty\": {\n        \"provider\": \"Dell\",\n        \"start_date\": \"2026-11-01\",\n        \"duration_months\": 24\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('created one asset', () => pm.expect(pm.response.json().created_asset_ids).to.have.length(1));",
                  "pm.collectionVariables.set('ocrAssetId', pm.response.json().created_asset_ids[0]);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refuse confirming twice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/documents/{{documentId}}/confirm",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assets\": [\n    {\n      \"name\": \"Postman Test Laptop\",\n      \"serial_number\": \"OCR2-{{serial}}\",\n      \"condition\": \"new\",\n      \"purchase_date\": \"2026-11-01\",\n      \"price\": \"32900.00\",\n      \"currency\": \"THB\",\n      \"invoice_number\": \"PM-INV-001\",\n      \"vendor_name\": \"Power Buy\",\n      \"category_name\": \"Laptop\",\n      \"storage_note\": \"Box on the top shelf\",\n      \"warranty\": {\n        \"provider\": \"Dell\",\n        \"start_date\": \"2026-11-01\",\n        \"duration_months\": 24\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict: a double tap cannot create the assets twice', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Notifications",
      "description": "",
