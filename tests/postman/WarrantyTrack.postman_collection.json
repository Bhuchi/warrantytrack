                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has the user', () => pm.expect(body.user.id).to.be.a('string'));",
                  "pm.test('belongs to a personal workspace', () => {",
                  "  const personal = body.memberships.find((m) => m.workspace.type === 'personal');",
                  "  pm.expect(personal, 'personal membership').to.exist;",
                  "  // Every later request acts in this workspace unless one was set already.",
                  "  if (!pm.variables.get('workspaceId')) {",
                  "    pm.collectionVariables.set('workspaceId', personal.workspace.id);",
                  "  }",
                  "});",
                  "// A serial number no earlier run has used.",
