    "name": "WarrantyTrack API",
    "description": "Every REST endpoint in docs/api.md, with tests (CLOUDAPPG5-101). Run the folders in order: later requests use ids saved by earlier ones.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Runs before every request. Adds the Cognito token and the workspace, so no",
          "// request has to remember them. Locally (AUTH_BACKEND=dev) both may be empty.",
          "const token = pm.variables.get('token');",
          "const workspace = pm.variables.get('workspaceId');",
          "const skipAuth = pm.request.headers.has('X-Skip-Auth');",
          "pm.request.headers.remove('X-Skip-Auth');",
          "if (token && !skipAuth) {",
          "  pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token });",
          "}",
          "// A request that sets its own X-Workspace-Id (the security test) keeps it.",
          "if (workspace && !skipAuth && !pm.request.headers.has('X-Workspace-Id')) {",
          "  pm.request.headers.upsert({ key: 'X-Workspace-Id', value: workspace });",
          "}"
        ]
      }
    }
  ],
