    {
      "name": "7. Security",
      "description": "",
      "item": [
        {
          "name": "Reject a request without a token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Skip-Auth",
                "value": "1"
              }
            ],
            "url": "{{baseUrl}}/assets"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Locally AUTH_BACKEND=dev lets everyone in, so this only means something on AWS.",
                  "if (pm.variables.get('token')) {",
                  "  pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "} else {",
                  "  pm.test.skip('401 Unauthorized (needs a real token: run against AWS)', () => {});",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Hide another workspace's data",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Workspace-Id",
                "value": "00000000-0000-0000-0000-000000000099"
              }
            ],
            "url": "{{baseUrl}}/assets"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404, not 403: it must not even confirm the workspace exists', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
