# Copy to frontend/.env.local and fill in. Never commit frontend/.env.local
#
# Not needed for `docker compose up` — Compose supplies these defaults.
#
# Anything prefixed NEXT_PUBLIC_ is visible in the browser.
# Never put a secret behind that prefix.

NEXT_PUBLIC_API_URL=http://localhost:8000
# Cognito app client (public, no secret). Leave empty to skip sign-in locally.
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REGION=ap-southeast-1
